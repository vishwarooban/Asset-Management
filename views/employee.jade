extends layout

block title
    | Employee Master

block content

    if message
        .alert.success= message

    .box

        form.row(action="/employees" method="GET")

            select(name="status")
                option(value="") All
                option(value="Active") Active
                option(value="Inactive") Inactive

            input(
                type="text"
                name="search"
                placeholder="Search employee"
            )

            button(type="submit") Filter

            button(
             type="button"
             onclick="document.getElementById('employeeModal').style.display='block'"
                ) Add Employee


    .box

        table
            thead
                tr
                    th Employee Code
                    th Employee Name
                    th Email
                    th Phone
                    th Status
                    th Action

            tbody

                each employee in employees

                    tr
                        td= employee.employee_code
                        td= employee.employee_name
                        td= employee.email
                        td= employee.phone

                        td
                            span(class="status " + employee.status)= employee.status

                        td
                            a(href="/employees/edit/" + employee.id) Edit


    //- ADD EMPLOYEE MODAL

    #employeeModal.modal

        .modal-content

            .modal-header
                h3 Add Employee

                span(
                    id="closeEmployeeModal"
                    class="close"
                ) &times;

            form.modal-form(
                action="/employees/add"
                method="POST"
            )

                label Employee Code
                input(
                    type="text"
                    name="employee_code"
                    placeholder="Employee Code"
                    required
                )

                label Employee Name
                input(
                    type="text"
                    name="employee_name"
                    placeholder="Employee Name"
                    required
                )

                label Email
                input(
                    type="email"
                    name="email"
                    placeholder="Email"
                    required
                )

                label Phone
                input(
                      type="tel"
                      name="phone"
                      placeholder="Phone"
                      pattern="[0-9]{10}"
                      maxlength="10"
                      minlength="10"
                      required
                      )

                .modal-actions

                    button(
                        type="button"
                        id="cancelEmployee"
                        class="btn-secondary"
                    ) Cancel

                    button(type="submit") Add Employee

         