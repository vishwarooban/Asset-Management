doctype html
html
    head
        title Employee Master
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Employee Master

        //- status filter
        form(action="/employees" method="GET")
          label status 
          select(name="status")
              option(value="") All
              option(value="Active") Active
              option(value="Inactive") Inactive
        
          br
          br

          label Search 
          input(type="text" name="search")

          br
          br

          button(type="submit" class="btn btn-primary") Filter

        //-    Add Employee

        form(action="/employees/add" method="POST")

            label Employee Code
            input(type="text" name="employee_code")
            br
            br

            label Employee Name
            input(type="text" name="employee_name")
            br
            br

            label Email
            input(type="email" name="email")
            br
            br

            label Phone
            input(type="text" name="phone")
            br
            br

            button(type="submit" class="btn btn-primary") Add Employee

             //-  Employee List


        h2 Employee List

        table(class="table table-striped table-bordered")

            tr
                th Employee Code
                th Employee Name
                th Email
                th Phone
                th Status
                th Action

            each employee in employees

                tr
                    td= employee.employee_code
                    td= employee.employee_name
                    td= employee.email
                    td= employee.phone
                    td= employee.status
                    td
                        a(href="/employees/edit/" + employee.id) Edit
         