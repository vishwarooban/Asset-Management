doctype html
html
    head
        title Asset History
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Asset History

        each asset in assets

            h2= asset.asset_unique_id + " - " + asset.asset_name

            table(class="table table-striped table-bordered")

                tr
                    th Transaction Type
                    th Transaction Date
                    th Employee
                    th Remarks

                each transaction in asset.AssetTransactions

                    tr
                        td= transaction.transaction_type
                        td= transaction.transaction_date

                        td
                            if transaction.Employee
                                = transaction.Employee.employee_name
                            else
                                | -

                        td= transaction.remarks

            br
            br
        script.
                document.querySelectorAll('table').forEach(function(table) {
                    new DataTable(table);
                })