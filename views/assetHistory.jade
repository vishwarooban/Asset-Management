extends layout

block title
    | Asset History

block content

    .box

        table
            thead
                tr
                    th Asset
                    th Transaction Type
                    th Transaction Date
                    th Employee
                    th Remarks

            tbody

                each asset in assets

                    each transaction in asset.transactions

                        tr

                            td
                                = asset.asset_unique_id
                                |  -
                                = asset.asset_name

                            td= transaction.transaction_type

                            td= new Date(transaction.transaction_date).toLocaleString("en-IN", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: true })

                            td
                                if transaction.Employee
                                    = transaction.Employee.employee_name
                                else
                                    | -

                            td= transaction.remarks