doctype html
html
    head
         title Stock View
         link(rel="stylesheet", href="/css/style.css")
         link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
         link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
         script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Stock View

        h2 Branch Wise Stock

        table(class="table table-striped table-bordered")
            tr
                th Branch
                th Total Assets
                th Total Value

            each value, branch in stock
                tr
                    td= branch
                    td= value.totalAssets
                    td= value.totalValue

        h2 Available Assets

        table(class="table table-striped table-bordered")
            tr
                th ID
                th Unique ID
                th Asset Name
                th Model
                th Serial Number
                th Purchase Value
                th Branch
                th Status

            each asset in assets
                tr
                    td= asset.id
                    td= asset.asset_unique_id
                    td= asset.asset_name
                    td= asset.model
                    td= asset.serial_number
                    td= asset.purchase_value
                    td= asset.Branch ? asset.Branch.branch_name : "No Branch"
                    td= asset.status

        script.
                document.querySelectorAll('table').forEach(function(table) {
                    new DataTable(table);
                })