extends layout

block title
    | Stock View

block content

    .box.stock-box

        h3 Branch Wise Stock

        table

            thead
                tr
                    th Branch
                    th Total Assets
                    th Total Value

            tbody

                each value, branch in stock

                    tr
                        td= branch
                        td= value.totalAssets
                        td= value.totalValue.toFixed(2)


    .stock-total-bar

        .total-item
            span Grand Total Assets
            strong= grandTotalAssets

        .total-item
            span Grand Total Value
            strong= grandTotalValue.toFixed(2)