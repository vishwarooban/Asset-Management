doctype html
html
    head
        title Return Asset
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Return Asset

        form(action="/return-asset/return" method="POST")

            label Select Asset

            select(name="AssetId")

                each asset in assets
                    option(value=asset.id)= asset.asset_unique_id + " - " + asset.asset_name

            br
            br

            label Return Reason / Remarks

            input(type="text" name="remarks")

            br
            br

            button(type="submit" class="btn btn-primary") Return Asset
    