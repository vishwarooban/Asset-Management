extends layout

block title
    | Scrap Asset

block content

    

    .box.scrap-box

        h3 Scrap Asset

        form.scrap-form(
            action="/scrap-asset/scrap"
            method="POST"
        )

            .scrap-field
                label Select Asset

                select(
                    name="AssetId"
                    required
                )
                    each asset in assets
                        option(value=asset.id)
                            = asset.asset_unique_id + " - " + asset.asset_name

            .scrap-field
                label Scrap Reason

                input(
                    type="text"
                    name="remarks"
                    placeholder="Enter scrap reason"
                    required
                )

            .scrap-actions
                button(type="submit") Scrap Asset