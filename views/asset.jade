doctype html
html
    head
        title Asset Master
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Asset Master
          //- Asset Filter and Search
        form(action="/assets" method="GET")
        

          label Model Search

          input(type="text" name="model" placeholder="Enter model")

          br
          br

          button(type="submit" class="btn btn-primary") Filter

 

        h2 Add Asset

        form(action="/assets/add" method="POST")

            label Asset Unique ID
            input(type="text" name="asset_unique_id")
            br
            br

            label Asset Name
            input(type="text" name="asset_name")
            br
            br

            label Model
            input(type="text" name="model")
            br
            br

            label Serial Number
            input(type="text" name="serial_number")
            br
            br

            label Purchase Date
            input(type="date" name="purchase_date")
            br
            br

            label Purchase Value
            input(type="text" name="purchase_value")
            br
            br



            label Branch
            select(name="BranchId")
               each branch in branches
                   option(value=branch.id)= branch.branch_name
            br
            br

            button(type="submit" class="btn btn-primary") Add Employee


        h2 Asset List

        table(class="table table-striped table-bordered")

            tr
                th ID
                th Unique ID
                th Asset Name
                th Model
                th Serial Number
                th Purchase Date
                th Purchase Value
                th Status
                th Action 

            each asset in assets

                tr
                    td= asset.id
                    td= asset.asset_unique_id
                    td= asset.asset_name
                    td= asset.model
                    td= asset.serial_number
                    td= asset.purchase_date
                    td= asset.purchase_value
                    td= asset.status
                    td
                         a(href="/assets/edit/" + asset.id) Edit

            script.
                document.querySelectorAll('table').forEach(function(table) {
                  new DataTable(table);
       })