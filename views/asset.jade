extends layout

block title
    | Asset Master

block content

    if message
        .alert.success= message

    .box
        form.row(action="/assets" method="GET")

            input(
                type="text"
                name="search"
                value=search
                placeholder="Search ID / Name / Model / Serial"
            )

            select(name="category")
                option(value="") All Categories

                each category in categories
                    option(
                        value=category.id
                        selected=selectedCategory == category.id
                    )= category.category_name

            button(type="submit") Filter


    .box

        h3 Add Asset

        form.row(action="/assets/add" method="POST")

            input(
                type="text"
                name="asset_unique_id"
                placeholder="Unique ID"
                required
            )

            input(
                type="text"
                name="asset_name"
                placeholder="Asset Name"
                required
            )

            input(
                type="text"
                name="model"
                placeholder="Model"
                required
            )

            input(
                type="text"
                name="serial_number"
                placeholder="Serial Number"
                required
            )

            input(
                type="date"
                name="purchase_date"
                required
            )

            input(
                type="number"
                step="0.01"
                name="purchase_value"
                placeholder="Purchase Value"
                required
            )

            select(name="AssetCategoryId" required)

                option(value="") Select Category

                each category in categories
                    option(value=category.id)= category.category_name

            select(name="BranchId" required)

                option(value="") Select Branch

                each branch in branches
                    option(value=branch.id)= branch.branch_name

            button(type="submit") Add Asset


    .box

        h3 Asset List

        table

            thead

                tr
                    th ID
                    th Unique ID
                    th Asset Name
                    th Category
                    th Model
                    th Serial Number
                    th Purchase Date
                    th Purchase Value
                    th Status
                    th Action

            tbody

                each asset in assets

                    tr

                        td= asset.id

                        td= asset.asset_unique_id

                        td= asset.asset_name

                        td
                            = asset.category ? asset.category.category_name : "-"

                        td= asset.model

                        td= asset.serial_number

                        td= new Date(asset.purchase_date).toLocaleDateString("en-IN")

                        td= asset.purchase_value

                        td
                            span(class="status " + asset.status)= asset.status

                        td
                            a(href="/assets/edit/" + asset.id) Edit