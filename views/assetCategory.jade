extends layout

block title
    | Asset Category Master

block content

    .box

        form.row(
            action="/asset-categories/add"
            method="POST"
        )

            input(
                type="text"
                name="category_name"
                placeholder="Category Name"
                required
            )

            button(type="submit") Add Category


    .box

        h3 Asset Categories

        table

            thead
                tr
                    th ID
                    th Category Name
                    th Status

            tbody

                each category in categories

                    tr
                        td= category.id
                        td= category.category_name

                        td
                            span(class="status " + category.status)= category.status