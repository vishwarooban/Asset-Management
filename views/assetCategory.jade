doctype html
html
    head
        title Asset Category Master
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Asset Category Master

        h2 Add Category

        form(action="/asset-categories/add" method="POST")

            label Category Name
            input(type="text" name="category_name")

            br
            br

            button(type="submit" class="btn btn-primary")  Add Category

        h2 Category List

        table(class="table table-striped table-bordered")

            tr
                th ID
                th Category Name
                th Status

            each category in categories

                tr
                    td= category.id
                    td= category.category_name
                    td= category.status

        script.
            document.querySelectorAll('table').forEach(function(table) {
                new DataTable(table);
            })