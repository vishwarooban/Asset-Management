doctype html 
html 
   head
      title Edit Employee 
      link(rel="stylesheet", href="/css/style.css")
      link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
      link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
      script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
     h1 Edit Employee

      form(action="/employees/update/" + employee.id method="POST")

        label Employee Code 
        input(type="text", name="employee_code" value=employee.employee_code)    
        br
        br

        label Employee Name 
        input(type="text", name="employee_name" value=employee.employee_name)    
        br
        br

        label Email 
        input(type="email", name="email" value=employee.email)    
        br
        br

        label Phone
        input(type="text", name="phone" value=employee.phone)    
        br
        br

        label status
        select(name="status")
           option(value="Active") Active 
           option(value="Inactive") Inactive
        br
        br 

        button(type="submit" class="btn btn-primary") Update Employee

         script.
                document.querySelectorAll('table').forEach(function(table) {
                    new DataTable(table);
                })
