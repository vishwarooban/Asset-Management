extends layout

block title
    | Issue Asset

block content

    .box.issue-box

        h3 Issue Asset

        form.issue-form(action="/issue-asset/issue" method="POST")

            .issue-field
                label Select Asset
                select(name="AssetId" required)
                    each asset in assets
                        option(value=asset.id)= asset.asset_unique_id + " - " + asset.asset_name

            .issue-field
                label Select Employee
                select(name="EmployeeId" required)
                    each employee in employees
                        option(value=employee.id)= employee.employee_code + " - " + employee.employee_name

            .issue-field
                label Remarks
                input(
                    type="text"
                    name="remarks"
                    placeholder="Enter remarks"
                )

            .issue-actions
                button(type="submit") Issue Asset