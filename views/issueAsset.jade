doctype html
html
    head
        title Issue Asset
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Issue Asset

        form(action="/issue-asset/issue" method="POST")

            label Select Asset
            select(name="AssetId")

                each asset in assets
                    option(value=asset.id)= asset.asset_unique_id + " - " + asset.asset_name

            br
            br

            label Select Employee
            select(name="EmployeeId")

                each employee in employees
                    option(value=employee.id)= employee.employee_code + " - " + employee.employee_name

            br
            br

            label Remarks
            input(type="text" name="remarks")

            br
            br

            button(type="submit" class="btn btn-primary") Issue Asset
    script.
                document.querySelectorAll('table').forEach(function(table) {
                    new DataTable(table);
                })