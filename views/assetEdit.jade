doctype html
html
    head
        title Edit Asset
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css")
        script(src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js")
    body

        h1 Edit Asset

        form(action="/assets/update/" + asset.id method="POST")

            label Asset Unique ID
            input(type="text" name="asset_unique_id" value=asset.asset_unique_id)
            br
            br

            label Asset Name
            input(type="text" name="asset_name" value=asset.asset_name)
            br
            br

            label Model
            input(type="text" name="model" value=asset.model)
            br
            br

            label Serial Number
            input(type="text" name="serial_number" value=asset.serial_number)
            br
            br

            label Purchase Date
            input(type="date" name="purchase_date" value=asset.purchase_date.toISOString().slice(0,10))
            br
            br

            label Purchase Value
            input(type="text" name="purchase_value" value=asset.purchase_value)
            br
            br

            label Asset Category
            select(name="AssetCategoryId")

                each category in categories

                    option(
                        value=category.id
                        selected=category.id == asset.AssetCategoryId
                    )= category.category_name

            br
            br

            label Status
            select(name="status")

                option(
                    value="Available"
                    selected=asset.status == "Available"
                ) Available

                option(
                    value="Issued"
                    selected=asset.status == "Issued"
                ) Issued

                option(
                    value="Returned"
                    selected=asset.status == "Returned"
                ) Returned

                option(
                    value="Scrapped"
                    selected=asset.status == "Scrapped"
                ) Scrapped

            br
            br

            button(type="submit" class="btn btn-primary")  Update Asset
     script.
            document.querySelectorAll('table').forEach(function(table) {
                    new DataTable(table);
                })