extends layout

block title
    | Edit Asset

block content

    .box.edit-box

        form.edit-form(action="/assets/update/" + asset.id method="POST")

            .form-field
                label Asset Unique ID
                input(
                    type="text"
                    name="asset_unique_id"
                    value=asset.asset_unique_id
                    required
                )

            .form-field
                label Asset Name
                input(
                    type="text"
                    name="asset_name"
                    value=asset.asset_name
                    required
                )

            .form-field
                label Model
                input(
                    type="text"
                    name="model"
                    value=asset.model
                    required
                )

            .form-field
                label Serial Number
                input(
                    type="text"
                    name="serial_number"
                    value=asset.serial_number
                    required
                )

            .form-field
                label Purchase Date
                input(
                    type="date"
                    name="purchase_date"
                    value=asset.purchase_date.toISOString().slice(0,10)
                    required
                )

            .form-field
                label Purchase Value
                input(
                    type="number"
                    step="0.01"
                    name="purchase_value"
                    value=asset.purchase_value
                    required
                )

            .form-field
                label Asset Category
                select(name="AssetCategoryId" required)

                    each category in categories
                        option(
                            value=category.id
                            selected=category.id == asset.AssetCategoryId
                        )= category.category_name

            .form-field
                label Branch
                select(name="BranchId" required)

                    each branch in branches
                        option(
                            value=branch.id
                            selected=branch.id == asset.BranchId
                        )= branch.branch_name

            .form-field.status-field
                label Status
                select(name="status")

                    option(
                        value="Available"
                        selected=asset.status == "Available"
                    ) Available

                    option(
                        value="Issued"
                        selected=asset.status == "Issued"
                    ) Issued

                    option(
                        value="Returned"
                        selected=asset.status == "Returned"
                    ) Returned

                    option(
                        value="Scrapped"
                        selected=asset.status == "Scrapped"
                    ) Scrapped

            .form-actions
                button(type="submit") Update Asset
     